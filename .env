# Telegram Bot
BOT_TOKEN=your_bot_token_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (опционально)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# GeoNames (для геокодирования)
GEONAMES_USERNAME=your_geonames_username_here

# Астрологические настройки
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_LATITUDE=55.7558
DEFAULT_LONGITUDE=37.6173

# Настройки базы данных (если используется)
DATABASE_URL=sqlite:///data/astrology_bot.db

# Настройки логирования
LOG_LEVEL=INFO
LOG_FILE=logs/astrology_bot.log

# Настройки тарифов
FREE_DAILY_FORECASTS=True
FREE_MONTHLY_REQUESTS=5